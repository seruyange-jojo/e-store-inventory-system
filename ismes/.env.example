# Copy this file to .env and adjust values before running docker compose up

POSTGRES_DB=ismes
POSTGRES_USER=ismes_user
POSTGRES_PASSWORD=changeme

# Must be at least 32 characters for HS256 JWT signing
JWT_SECRET=please-change-this-secret-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# Used when there are no users or when upgrading the untouched legacy admin seed.
# Existing customized accounts/passwords are preserved on restart.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
